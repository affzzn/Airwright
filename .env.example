# ============================================================
# Airwright Platform — environment variables
# Copy to `.env.local` for local dev; set the same keys in Render for deploy.
# ============================================================

# --- Database (Supabase Postgres, EU/UK region) ---
# POOLED connection (PgBouncer, port 6543) — used by the Next.js app via Prisma.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT connection (port 5432) — used by Prisma migrations AND the pg-boss worker.
# pg-boss needs LISTEN/NOTIFY + advisory locks, which do NOT work through PgBouncer.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service-role key is SERVER-ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Private Storage bucket for tender packs / drawings.
SUPABASE_STORAGE_BUCKET="tender-packs"

# --- Anthropic (Claude) — the default extraction provider ---
ANTHROPIC_API_KEY="sk-ant-..."
# Model used behind extractDrawing(). Pin an exact id in production.
ANTHROPIC_EXTRACTION_MODEL="claude-opus-4-8"

# --- Other extraction providers (selectable per project on the new-project form) ---
# A key is required ONLY when that provider is actually chosen for a project.
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="..."            # or GOOGLE_API_KEY
# Optional API-model-id overrides (defaults shown), so a newer id is one line:
OPENAI_EXTRACTION_MODEL="gpt-5.6"
GEMINI_EXTRACTION_MODEL="gemini-3.1-pro-preview"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Monitoring (fast-follow; optional in Week 1) ---
SENTRY_DSN=""
