// ============================================================
// Airwright — Build 1 (Quote & Take-off Engine) — Prisma schema
// Operation-level staged take-off, dimension-traceable measurements, two modes.
//
// Pipeline this models:
//   Extraction → Measurements + WallSegments (traceable, per-field confidence)
//   → [Colin confirms] → ScaffoldOperations (typed, staged, priced)
//   → per Plot + config + RateCard → QuoteLineItems (immutable snapshot)
//
// Prisma owns schema/migrations. Supabase = Postgres, Auth, Storage only.
// See docs/04-data-model.md for the full explanation.
// ============================================================

generator client {
  provider        = "prisma-client-js"
  // Collapse nested includes into a single SQL query (LATERAL joins) instead of
  // one round-trip per relation — big win against a remote (EU) database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) for the app
  directUrl = env("DIRECT_URL") // direct (5432) for migrations + pg-boss
}

// ---------- Enums ----------
enum Role {
  ESTIMATOR
  ADMIN
  VIEWER
}

enum EstimatingMode {
  HOUSE_BUILD
  CONSTRUCTION
}

enum RateBand {
  SUPER_COMPETITIVE
  COMPETITIVE
  MEDIUM
  HIGH
  CUSTOM
}

enum BuildType {
  TRADITIONAL
  TIMBER_FRAME
}

enum Configuration {
  DETACHED
  SEMI_DETACHED
  END_TERRACE
  MID_TERRACE
}

enum AccessType {
  HAKI_STAIR
  LADDER_TOWER
}

enum GarageType {
  SINGLE
  TWIN
  CAR_PORT
}

enum DocumentKind {
  ELEVATION
  FLOOR_PLAN
  PLOT_LAYOUT
  SPEC
  PRICING_TEMPLATE
  ASSEMBLED // a synthetic combined PDF assembled from a house type's pages (docs/17)
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
}

// Which payment-stage split applies (splits differ by house shape).
enum StageScenario {
  STANDARD // 50 / 25 / 25 (confirmed)
  BUNGALOW // 65 / 10 / 25 (confirmed)
  NO_BIRDCAGE // 75 / 0 / 25 (confirmed from the matrix column header — docs/15 §5)
  GARAGE // 65 / 10 / 25 (garage section — docs/15 §6)
  GARAGE_NO_BCAGE // 75 / 0 / 25 (garage, no birdcage — docs/15 §6)
  TIMBER_FRAME // 80 / 20 (two-stage — docs/15 §7)
}

enum QuoteType {
  HOUSEBUILDING
  CONSTRUCTION
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  WON
  LOST
}

enum FieldSource {
  AI_EXTRACTED
  MANUAL
  EDITED
  DERIVED
}

enum Unit {
  LM
  M2
  EACH
  LIFT
  WEEK
}

// What the AI reads off the elevations (review / provenance layer)
enum MeasurementKey {
  HEIGHT_TO_SOFFIT
  ROOF_PITCH
  STOREYS
  LIFTS
  GABLE_QTY
  RENDER_LENGTH
  BIRDCAGE_GF_M2
  BIRDCAGE_FF_M2
  BIRDCAGE_SF_M2
  LOW_LEVEL_QTY
  FOOT_SCAFFOLD_QTY
  CORNER_COUNT
  OTHER
}

enum WallPosition {
  FRONT
  REAR
  GABLE_LEFT
  GABLE_RIGHT
  OTHER
}

// The priced components in the staged take-off (engine layer)
enum ScaffoldComponent {
  LIFT
  GABLE
  GABLE_RAILS
  RENDER_ADAPTION
  BIRDCAGE_GF
  BIRDCAGE_FF
  BIRDCAGE_SF
  BIRDCAGE_TF
  TF_EXTERNAL // timber-frame: the single external erect (matrix col E) — docs/15 §7
  ADAPTION // DEPRECATED (pre-call guess) — replaced by the two LM adaptions below
  ADAPTION_INSIDE_BOARD // timber-frame: inside-board adaption, all lifts + apex×4 LM (docs/18)
  ADAPTION_HOP_UP // timber-frame: hop-up adaption, lifts−1 + apex×4 LM (docs/18)
  LOADING_BAY
  HAKI
  LADDER_TOWER
  RUBBISH_CHUTE
  TABLE_LIFT
  JOIST_SUPPORT
  FOOT_SCAFFOLD
  LOW_LEVEL
  PARTY_WALL
  CONSTRUCTION_LINE
  OTHER
}

enum PageKind {
  ELEVATION
  FLOOR_PLAN
  SECTION
  PLOT_LAYOUT
  SPEC
  OTHER
}

// File-level purpose (which FILES in a pack matter, not just which pages).
enum DocumentCategory {
  PENDING
  HOUSE_TYPE_DRAWINGS
  SITE_LAYOUT
  SPEC
  NOT_RELEVANT
  UNCERTAIN
  UNREADABLE
}

enum OperationAction {
  ERECT
  DISMANTLE
}

enum OperationGroup {
  MAIN
  GARAGE
}

// ---------- Users (mirrors Supabase auth.users) ----------
model User {
  id        String     @id @db.Uuid
  email     String     @unique
  name      String?
  role      Role       @default(ESTIMATOR)
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

// ---------- Org ----------
model Client {
  id              String                 @id @default(cuid())
  name            String
  defaultBand     RateBand               @default(MEDIUM)
  createdAt       DateTime               @default(now())
  projects        Project[]
  houseTypes      HouseType[]
  builderProfiles BuilderProfile[]
  matrixTemplates ClientMatrixTemplate[]
}

// ---------- Housebuilder specification profile (per builder, versioned) ----------
// The stored spec that governs the "extras" a take-off gets — access type,
// loading bay policy, beam-overs, chimney rule, propping, etc. Specs are per
// HOUSEBUILDER, not per house (confirmed 13 Aug). Fields are nullable so a
// profile can start as a placeholder and be filled as the real spec arrives.
model BuilderProfile {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String // e.g. "Keepmoat standard 2026"
  version       Int         @default(1)
  effectiveFrom DateTime    @default(now())
  isActive      Boolean     @default(true)
  // Confirmed/typed spec fields (null = not yet known)
  accessType            AccessType? // preferred access tower
  ladderAllowedConfined Boolean     @default(false) // ladder permitted in confined areas (a permission, not an instruction)
  beamOverLowLevel      Boolean     @default(false) // beam over porch/bay instead of a returning low-level
  chimneyScaffoldAlways Boolean     @default(false) // demands a chimney scaffold even when none is drawn
  birdcageLiftsOver2p5m Int? // e.g. 2 lifts where a room exceeds 2.5 m (one client)
  loadingBayPolicy      String? // free-text until the rule is pinned down
  joistSupportVariant   String? // single / double / sacrificial
  extraHirePolicy       String? // refuse / zero / charge
  storeyLiftTemplate    Json? // per-builder storey→lifts map, e.g. {"1":2,"2":3,"2.5":5,"3":6} (Barratt 2→3 vs Standard 2→4); null → engine default
  matrixTemplateId      String? // the client matrix template they insist on (soft pointer)
  ingestProfile         Json? // smart-upload grouping rules (docs/17); null → use a built-in code profile
  notes                 String?
  spec                  Json? // flexible bag for anything not yet typed
  createdAt             DateTime    @default(now())

  @@index([clientId])
}

// ---------- Client's own pricing-matrix template (for the client-specific export) ----------
model ClientMatrixTemplate {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  storageBucket String   @default("tender-packs")
  storagePath   String? // the uploaded template file (null until uploaded)
  fieldMapping  Json? // { ourField: "their column header", ... }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([clientId])
}

model Project {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  name           String
  reference      String?
  estimatingMode EstimatingMode     @default(HOUSE_BUILD)
  // The build system for this tender (project-level — docs/18). Chosen on the
  // new-tender form; selects the take-off + pricing logic (TRADITIONAL vs
  // TIMBER_FRAME) for every house type + plot. Supersedes the per-house-type read.
  buildType      BuildType          @default(TRADITIONAL)
  // Which LLM reads this project's drawings (a model KEY from the provider
  // catalog, e.g. "anthropic-opus-4-8" / "gemini-3-1-pro" / "openai-gpt-5-6").
  // Null → the default (Anthropic Opus 4.8). Chosen on the new-project form.
  extractionModel String?
  // Commercial rate band for this tender's pricing. Null → use the client's
  // defaultBand. Chosen on the pricing screen; the matrix prices at this band.
  rateBand       RateBand?
  status         String             @default("TENDER")
  archivedAt     DateTime? // set when the tender is archived (hidden from the default list)
  createdAt      DateTime           @default(now())
  packs          TenderPack[]
  houseTypes     HouseType[]
  plots          Plot[]
  quotes         Quote[]
  construction   ConstructionScope?

  @@index([clientId])
}

// ---------- Documents & extraction ----------
model TenderPack {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int          @default(1)
  receivedAt DateTime     @default(now())
  documents  Document[]
  uploads    PackUpload[]

  // Smart-upload / cross-file grouping (docs/17). Set by the worker after it
  // groups the pack into house types; the confirm screen reads groupingData.
  builderProfileId String? // detected builder ingest profile id (e.g. "vistry")
  groupingStatus   String? // null (legacy per-file) | PROPOSED | CONFIRMED | FALLBACK
  groupingData     Json? // the grouping proposal (groups, ignored, unplaced, flags)

  @@index([projectId])
}

// Staging for raw uploaded files (PDFs and ZIPs) before they become Documents.
// A ZIP is expanded by the process-pack worker into individual Document rows.
model PackUpload {
  id          String     @id @default(cuid())
  packId      String
  pack        TenderPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  fileName     String
  relativePath String? // path inside the uploaded folder/zip (docs/17 — grouping signal)
  storagePath  String
  mimeType     String
  sizeBytes    Int?
  isArchive    Boolean    @default(false)
  status       String     @default("PENDING") // PENDING | PROCESSED | FAILED
  error       String?
  createdAt   DateTime   @default(now())

  @@index([packId])
}

model Document {
  id             String           @id @default(cuid())
  packId         String
  pack           TenderPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  kind           DocumentKind     @default(OTHER)
  fileName       String
  relativePath   String? // path inside the uploaded folder/zip (docs/17 — grouping signal)
  contentHash    String? // for zip-vs-unzipped dedupe (docs/17)
  pageManifest   Json? // ASSEMBLED docs: assembled page → source file+page (provenance)
  storageBucket  String           @default("tender-packs")
  storagePath    String
  mimeType       String
  pageCount      Int?
  sizeBytes      Int?
  isReadable     Boolean          @default(true)
  isRasterOnly   Boolean          @default(false)
  needsReview    Boolean          @default(false) // flagged for a human (e.g. unreadable raster)
  category       DocumentCategory @default(PENDING) // file-level relevance
  categoryDetail String? // e.g. "Bar schedule", "Levels"
  included       Boolean          @default(true) // manual override: use this file?
  relevantPages  Int              @default(0) // denormalised (avoids heavy per-page queries)
  plotListData   Json? // stored plot-list extraction (plot → house-type ref) for re-matching
  classifiedAt   DateTime?
  uploadedAt     DateTime         @default(now())
  extractions    Extraction[]
  pages          DocumentPage[]

  @@index([packId])
  @@index([kind])
}

// Persisted per-page classification (from the free text-layer classifier).
model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  kind          PageKind @default(OTHER)
  relevant      Boolean  @default(false) // relevant to a scaffold take-off
  houseTypeCode String?
  houseTypeName String?
  sheetTitle    String?
  createdAt     DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([houseTypeCode])
}

model Extraction {
  id            String           @id @default(cuid())
  documentId    String
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  houseTypeId   String?
  houseType     HouseType?       @relation(fields: [houseTypeId], references: [id], onDelete: SetNull)
  pageRange     String?
  model         String
  promptVersion String
  schemaVersion String?
  status        ExtractionStatus @default(PENDING)
  rawOutput     Json?
  errorMessage  String?
  processingStartedAt DateTime? // when the worker began reading (for the live progress estimate)
  latencyMs     Int?
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Decimal?         @db.Decimal(10, 4)
  createdAt     DateTime         @default(now())
  seededTakeoff Takeoff?         @relation("TakeoffSeed")

  @@index([documentId])
  @@index([houseTypeId])
  @@index([status])
}

// ---------- House type (first-class identity: builder + code) ----------
model HouseType {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id])
  name        String
  code        String?
  buildType   BuildType?
  createdAt   DateTime     @default(now())
  extractions Extraction[]
  takeoff     Takeoff?
  plots       Plot[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([clientId, code])
}

// ---------- Take-off ----------
model Takeoff {
  id               String               @id @default(cuid())
  houseTypeId      String               @unique
  houseType        HouseType            @relation(fields: [houseTypeId], references: [id], onDelete: Cascade)
  seedExtractionId String?              @unique
  seedExtraction   Extraction?          @relation("TakeoffSeed", fields: [seedExtractionId], references: [id], onDelete: SetNull)
  status           ReviewStatus         @default(DRAFT)
  warnings         Json?
  confirmedById    String?              @db.Uuid
  confirmedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  measurements     TakeoffMeasurement[]
  wallSegments     WallSegment[]
  operations       ScaffoldOperation[]

  @@index([houseTypeId])
}

model TakeoffMeasurement {
  id              String         @id @default(cuid())
  takeoffId       String
  takeoff         Takeoff        @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  key             MeasurementKey
  label           String?
  valueNumber     Decimal?       @db.Decimal(10, 3)
  valueText       String?
  unit            Unit?
  aiValue         String?
  confidence      Float?
  source          FieldSource    @default(AI_EXTRACTED)
  sourceSheet     String?
  sourceDimension String?
  ambiguous       Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@unique([takeoffId, key])
  @@index([takeoffId])
}

model WallSegment {
  id              String       @id @default(cuid())
  takeoffId       String
  takeoff         Takeoff      @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  position        WallPosition @default(OTHER)
  label           String?
  lengthM         Decimal      @db.Decimal(7, 3)
  aiLengthM       Decimal?     @db.Decimal(7, 3)
  shareable       Boolean      @default(false)
  confidence      Float?
  source          FieldSource  @default(AI_EXTRACTED)
  sourceSheet     String?
  sourceDimension String?
  ambiguous       Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([takeoffId])
}

model ScaffoldOperation {
  id         String            @id @default(cuid())
  takeoffId  String
  takeoff    Takeoff           @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  group      OperationGroup    @default(MAIN)
  garageType GarageType?
  component  ScaffoldComponent
  action     OperationAction
  liftLevel  Int?
  quantity   Decimal           @db.Decimal(10, 2)
  aiQuantity Decimal?          @db.Decimal(10, 2)
  unit       Unit
  derived    Boolean           @default(false)
  confidence Float?
  source     FieldSource       @default(AI_EXTRACTED)
  note       String?
  createdAt  DateTime          @default(now())

  @@index([takeoffId])
  @@index([component, action])
}

// ---------- Plots ----------
model Plot {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  houseTypeId   String
  houseType     HouseType       @relation(fields: [houseTypeId], references: [id], onDelete: Restrict)
  plotNumber    String
  configuration Configuration   @default(DETACHED)
  blockGroup    String?
  isRendered    Boolean         @default(false)
  // Party-wall scaffold (inside apex, no rails) is a priced spec item on every
  // non-detached house; a customer can opt out at spec stage → set this false.
  includePartyWall Boolean      @default(true)
  accessType    AccessType?
  hasGarage     Boolean         @default(false)
  garageType    GarageType?
  specNotes     String?
  createdAt     DateTime        @default(now())
  quoteLines    QuoteLineItem[]

  @@unique([projectId, plotNumber])
  @@index([projectId])
  @@index([houseTypeId])
}

// ---------- Rates (versioned) ----------
model RateCard {
  id            String         @id @default(cuid())
  name          String
  mode          EstimatingMode @default(HOUSE_BUILD)
  effectiveFrom DateTime
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  items         RateItem[]
  stageSplits   StageSplit[]
  quotes        Quote[]
}

model RateItem {
  id         String            @id @default(cuid())
  rateCardId String
  rateCard   RateCard          @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  component  ScaffoldComponent
  action     OperationAction   @default(ERECT)
  band       RateBand
  // Per-lift-level pricing (docs/15 §3, P2): the client matrix prices each lift
  // level separately and the 1st lift is dearer. liftLevel 0 = the BASE/default
  // rate (upper lifts + every non-lift component); 1..8 = a specific lift level.
  liftLevel  Int               @default(0)
  unit       Unit
  rate       Decimal           @db.Decimal(10, 2)
  payPercent Decimal?          @db.Decimal(5, 2)

  @@unique([rateCardId, component, action, band, liftLevel])
  @@index([rateCardId])
}

model StageSplit {
  id         String        @id @default(cuid())
  rateCardId String
  rateCard   RateCard      @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  scenario   StageScenario @default(STANDARD) // which house shape this split applies to
  name       String
  percent    Decimal       @db.Decimal(5, 2)
  sortOrder  Int           @default(0)

  @@index([rateCardId])
}

model ConstructionRateItem {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  category  String?
  unit      Unit
  band      RateBand?
  rate      Decimal   @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model ConstructionScope {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hireWeeks        Int?
  permits          String?
  access           String?
  groundConditions String?
  notes            String?
  createdAt        DateTime @default(now())
}

// ---------- Quote / output (immutable snapshot) ----------
model Quote {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rateCardId  String?
  rateCard    RateCard?       @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  type        QuoteType       @default(HOUSEBUILDING)
  band        RateBand        @default(MEDIUM)
  version     Int             @default(1)
  status      QuoteStatus     @default(DRAFT)
  total       Decimal         @default(0) @db.Decimal(12, 2)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  lineItems   QuoteLineItem[]

  @@index([projectId])
  @@index([status])
}

model QuoteLineItem {
  id          String             @id @default(cuid())
  quoteId     String
  quote       Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  plotId      String?
  plot        Plot?              @relation(fields: [plotId], references: [id], onDelete: SetNull)
  description String
  component   ScaffoldComponent?
  action      OperationAction?
  liftLevel   Int?
  group       OperationGroup     @default(MAIN)
  stage       String?
  quantity    Decimal            @db.Decimal(10, 2)
  unit        Unit
  rate        Decimal            @db.Decimal(10, 2)
  amount      Decimal            @db.Decimal(12, 2)
  hireWeeks   Int?
  createdAt   DateTime           @default(now())

  @@index([quoteId])
  @@index([plotId])
}

// ---------- Audit ----------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}
